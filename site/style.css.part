<style>
/* Layout: an editorial report column (760px) with charts in the column and one wide county chart; same identity as the
   companion figures page. Type: Archivo expanded for display, Public Sans for reading and numbers, IBM Plex Mono for labels.
   Color: warm paper neutrals; party red and blue only on party marks; a neutral ink for everything else. */
:root{
  --bg:#f2f1ec; --surface:#fbfbf8; --ink:#121210; --ink2:#4f4e49; --muted:#77756e; --rule:#e2e0d9; --axis:#9a9891;
  --grid:#e7e5df; --chart-muted:#9c9a93; --chart-soft:#d6d4cd; --row-hover:#f5f4ef; --on-ink:#ffffff;
  --deep-bg:#121210; --deep-fg:#f2f1ec; --deep-fg2:#c9c7bf; --deep-card:#ffffff; --deep-card-fg:#121210; --deep-card-fg2:#4f4e49;
  --tip-bg:#121210; --tip-fg:#f2f1ec; --focus:#2a78d6;
  --rep:#e34948; --dem:#2a78d6;
  --display:"Archivo","Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --body:"Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --text:760px; --wide:1180px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#141412; --surface:#1c1c19; --ink:#f1f0eb; --ink2:#c6c4bc; --muted:#97958d; --rule:#33322d; --axis:#6c6a63;
  --grid:#2c2b27; --chart-muted:#7c7a73; --chart-soft:#45443e; --row-hover:#22221e; --on-ink:#141412;
  --deep-bg:#f1f0eb; --deep-fg:#141412; --deep-fg2:#4f4e49; --deep-card:#141412; --deep-card-fg:#f1f0eb; --deep-card-fg2:#c6c4bc;
  --tip-bg:#f1f0eb; --tip-fg:#141412; --focus:#7fb0ee;
  --rep:#e5524f; --dem:#3f86dd; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#141412; --surface:#1c1c19; --ink:#f1f0eb; --ink2:#c6c4bc; --muted:#97958d; --rule:#33322d; --axis:#6c6a63;
  --grid:#2c2b27; --chart-muted:#7c7a73; --chart-soft:#45443e; --row-hover:#22221e; --on-ink:#141412;
  --deep-bg:#f1f0eb; --deep-fg:#141412; --deep-fg2:#4f4e49; --deep-card:#141412; --deep-card-fg:#f1f0eb; --deep-card-fg2:#c6c4bc;
  --tip-bg:#f1f0eb; --tip-fg:#141412; --focus:#7fb0ee;
  --rep:#e5524f; --dem:#3f86dd; color-scheme:dark}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.62;-webkit-font-smoothing:antialiased}
a{color:var(--ink);text-decoration-color:var(--axis);text-underline-offset:3px}
a:hover{text-decoration-color:var(--ink)}
a:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.wrap{max-width:var(--wide);margin:0 auto;padding-left:max(16px, env(safe-area-inset-left, 0px));padding-right:max(16px, env(safe-area-inset-right, 0px))}
@media (min-width:761px){.wrap{padding-left:max(32px, env(safe-area-inset-left, 0px));padding-right:max(32px, env(safe-area-inset-right, 0px))}}
.text{max-width:var(--text);min-width:0}
.sw{display:inline-block;width:.7em;height:.7em;border-radius:2px;margin-right:.4em;vertical-align:baseline;position:relative;top:.02em}
.sw.r{background:var(--rep)} .sw.d{background:var(--dem)}

header.hero{padding-block:68px 20px}
.kicker,.eyebrow{font-family:var(--mono);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500;margin:0 0 14px}
h1{font-family:var(--display);font-stretch:118%;font-size:clamp(34px,4.6vw,60px);line-height:1.03;letter-spacing:-.025em;font-weight:800;margin:0 0 22px;max-width:15em;text-wrap:balance}
.dek{font-size:clamp(18px,1.6vw,21px);line-height:1.52;color:var(--ink2);margin:0;max-width:37em}
.dek b{color:var(--ink);font-weight:650}
.tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:36px}
.tile{background:var(--surface);border:1px solid var(--rule);border-radius:14px;padding:16px 18px;min-width:0}
.tile .label{font-size:13.5px;color:var(--ink2);font-weight:600;line-height:1.35;margin:0 0 8px}
.tile .big{font-family:var(--display);font-stretch:108%;font-size:clamp(26px,2.3vw,34px);font-weight:760;letter-spacing:-.015em;line-height:1.1;margin:0;font-variant-numeric:tabular-nums}
.tile .sub{font-size:13.5px;color:var(--muted);line-height:1.45;margin:8px 0 0}
.asof{font-size:13.5px;color:var(--muted);margin:18px 0 0;max-width:var(--text)}

section{padding-block:56px 0}
h2{font-family:var(--display);font-stretch:110%;font-size:clamp(25px,2.5vw,34px);line-height:1.12;letter-spacing:-.02em;font-weight:760;margin:0 0 14px;text-wrap:balance}
h3{font-family:var(--display);font-stretch:104%;font-size:19px;line-height:1.3;font-weight:700;margin:34px 0 8px}
p{margin:0 0 14px}
.lede{font-size:19px;color:var(--ink2)}
ul.brief{padding-left:0;list-style:none;margin:6px 0 0;display:grid;gap:12px}
ul.brief li{padding-left:18px;position:relative}
ul.brief li::before{content:"";position:absolute;left:0;top:.62em;width:7px;height:7px;border-radius:50%;background:var(--ink)}
ul.plain{padding-left:20px;margin:8px 0 14px} ul.plain li{margin:0 0 7px}

figure.ch{margin:22px 0 10px;background:var(--surface);border:1px solid var(--rule);border-radius:14px;padding:16px 16px 10px;max-width:var(--text)}
figure.ch.wide{max-width:var(--wide)}
figure.ch figcaption{font-size:13.5px;color:var(--muted);line-height:1.45;margin:8px 2px 2px}
figure.ch figcaption b{color:var(--ink2);font-weight:600}
.chart-title{font-family:var(--display);font-stretch:104%;font-weight:700;font-size:16px;margin:0 2px 8px;color:var(--ink)}
svg.chart{display:block;width:100%;height:auto;overflow:visible}
figure.ch>div{overflow-x:auto}
@media (max-width:640px){svg.chart{min-width:600px}figure.ch.wide svg.chart{min-width:880px}}
svg.chart .ax{font:12px var(--body);fill:var(--muted)}
svg.chart .lbl{font:13px var(--body);fill:var(--ink)}
svg.chart .val{font:600 12.5px var(--body);fill:var(--ink);font-variant-numeric:tabular-nums}
svg.chart .val-in{font:600 12.5px var(--body);fill:#ffffff}
svg.chart .note{font:12px var(--body);fill:var(--ink2)}
svg.chart .grid{stroke:var(--grid);stroke-width:1}
svg.chart .zero{stroke:var(--axis);stroke-width:1.2}
svg.chart .f-dem{fill:var(--dem)} svg.chart .f-rep{fill:var(--rep)} svg.chart .f-ink{fill:var(--ink)} svg.chart .f-ink2{fill:var(--ink2)}
svg.chart .f-mute{fill:var(--chart-muted)} svg.chart .f-soft{fill:var(--chart-soft)}
svg.chart .o45{fill-opacity:.42}
svg.chart .dot{fill:var(--chart-muted);fill-opacity:.55;stroke:var(--surface);stroke-width:.7}
svg.chart .dot-b{fill:var(--ink);fill-opacity:.82;stroke:var(--surface);stroke-width:.7}
svg.chart .conn{stroke:var(--chart-muted);stroke-width:2}
svg.chart .pt22{fill:var(--surface);stroke:var(--ink2);stroke-width:2}
svg.chart .pt26{fill:var(--ink)}
svg.chart .lead{stroke:var(--axis);stroke-width:1}
svg.chart [data-tip]{cursor:default}
svg.chart rect[data-tip]:hover,svg.chart circle[data-tip]:hover{stroke:var(--ink);stroke-width:1.5}
#tip{position:fixed;z-index:20;pointer-events:none;background:var(--tip-bg);color:var(--tip-fg);font:13px/1.4 var(--body);padding:6px 9px;border-radius:7px;max-width:300px;box-shadow:0 6px 18px rgba(0,0,0,.25)}

.tblwrap{overflow-x:auto;max-width:var(--text);margin:16px 0 8px;background:var(--surface);border:1px solid var(--rule);border-radius:12px}
.tblwrap.wide{max-width:var(--wide)}
table{border-collapse:collapse;width:100%;font-size:14.5px}
th,td{padding:9px 12px;text-align:right;border-bottom:1px solid var(--rule);vertical-align:top;font-variant-numeric:tabular-nums}
th{font-family:var(--mono);font-size:11.5px;font-weight:500;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
th.l,td.l{text-align:left}
tbody tr:last-child td{border-bottom:0}
tbody tr:hover td{background:var(--row-hover)}
td .v{font-weight:650}
.verdict{font-family:var(--mono);font-size:12px;font-weight:500;padding:2px 7px;border-radius:999px;border:1px solid var(--rule);white-space:nowrap;color:var(--ink2)}
.verdict.ok{border-color:var(--ink2);color:var(--ink)}
table.claims td{font-variant-numeric:normal}
table.claims td:nth-child(1){min-width:240px} table.claims td:nth-child(2){min-width:240px}

.callout{background:var(--surface);border:1px solid var(--rule);border-left:3px solid var(--ink);border-radius:10px;padding:14px 18px;margin:18px 0;max-width:var(--text)}
.callout p:last-child{margin-bottom:0}
.links{margin:64px 0 0;max-width:var(--wide);background:var(--deep-bg);color:var(--deep-fg);border-radius:20px;padding:34px 40px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px 28px}
.links h2{color:var(--deep-fg);grid-column:1/-1;margin:0}
.links a{display:block;background:var(--deep-card);color:var(--deep-card-fg);text-decoration:none;border-radius:14px;padding:18px 20px;font-family:var(--display);font-stretch:106%;font-weight:700;font-size:17px;line-height:1.35}
.links a span{display:block;font-family:var(--body);font-weight:400;font-size:14px;color:var(--deep-card-fg2);margin-top:6px}
.links a:hover{box-shadow:0 0 0 3px var(--axis)}
footer{padding-block:36px 56px;font-size:13.5px;color:var(--muted)}
@media (max-width:1000px){.tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:640px){.tiles{grid-template-columns:minmax(0,1fr)}.links{grid-template-columns:minmax(0,1fr);padding:26px 20px}header.hero{padding-block:44px 16px}}
</style>
